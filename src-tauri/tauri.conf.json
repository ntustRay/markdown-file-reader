{
  "productName": "QuillTide Reader",
  "version": "0.2.0",
  "identifier": "com.quilltide.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QuillTide Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "category": "Productivity",
    "shortDescription": "Offline Markdown Reader & Editor",
    "longDescription": "QuillTide Reader is a local-first Markdown reader and editor with dark mode, split editing, and folder-based file management. No cloud sync or collaborative editing for now."
  },
  "plugins": {}
}
