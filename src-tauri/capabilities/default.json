{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Minimum permissions for the Android document workflow",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ],
  "platforms": ["android"]
}
